# ကိုယ်တိုင် ရွေးထားတဲ့ လျှို့ဝှက်စာသား (Facebook webhook setting မှာ ထည့်မယ့်ဟာနဲ့ တူရမယ်)
VERIFY_TOKEN=change-me-to-a-random-secret

# Test Landing page အတွက် page access token (developers.facebook.com က ထုတ်မယ်)
PAGE_ACCESS_TOKEN=

# Google AI Studio API key — https://aistudio.google.com/app/apikey က အခမဲ့ထုတ်ယူနိုင်ပါတယ်
GEMINI_API_KEY=

# သုံးမယ့် AI model (လိုအပ်ရင် ပြောင်းနိုင်တယ် — ဥပမာ gemini-2.0-flash, gemini-3-flash)
GEMINI_MODEL=gemini-2.5-flash

PORT=8000
